@{ Layout = "~/Views/Shared/_CustomerLayout.cshtml"; ViewBag.Title = "Quản trị"; }
<h2>Bảng điều khiển Admin</h2><div class="row"><div class="col-md-4"><div class="stat-card"><h3>@ViewBag.CategoryCount</h3><p>Danh mục</p></div></div><div class="col-md-4"><div class="stat-card"><h3>@ViewBag.ProductCount</h3><p>Sản phẩm</p></div></div><div class="col-md-4"><div class="stat-card"><h3>@ViewBag.OrderCount</h3><p>Đơn hàng</p></div></div></div>
<a class="btn btn-primary mr-2" href="@Url.Action("Categories")">Quản lý danh mục</a><a class="btn btn-success" href="@Url.Action("Products")">Quản lý sản phẩm</a>
