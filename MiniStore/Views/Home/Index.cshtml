@model MiniStore.Models.ViewModel.HomeProductVM
@{ Layout = "~/Views/Shared/_CustomerLayout.cshtml"; ViewBag.Title = "Trang chủ"; }
<section class="hero rounded p-5 mb-4 text-white">
    <h1>Chào mừng đến MiniStore</h1><p>Mua sắm dễ dàng – sản phẩm phù hợp cho bạn.</p>
    @using (Html.BeginForm("ProductList","Home",FormMethod.Get,new {@class="form-inline"})) {
        <input class="form-control mr-2 mb-2" name="searchTerm" value="@Model.SearchTerm" placeholder="Tên, mô tả hoặc danh mục" />
        <button class="btn btn-warning mb-2">Tìm sản phẩm</button>
    }
</section>
<h2 class="mb-3">Sản phẩm nổi bật</h2>
<div class="row">
@foreach (var p in Model.FeaturedProducts) {
    <div class="col-md-3 mb-4"><div class="card h-100 product-card">
        <img class="card-img-top product-image" src="@Url.Content(string.IsNullOrWhiteSpace(p.ProductImage) ? "~/Content/no-image.svg" : p.ProductImage)" alt="@p.ProductName" />
        <div class="card-body"><small class="text-muted">@(p.Category == null ? "" : p.Category.CategoryName)</small><h5>@p.ProductName</h5><p class="price">@p.ProductPrice.ToString("N0") đ</p><a class="btn btn-primary" href="@Url.Action("ProductDetail",new{id=p.ProductID})">Xem chi tiết</a></div>
    </div></div>
}
</div>
<h2 class="mb-3">Sản phẩm mới</h2>
<div class="row">
@foreach (var p in Model.NewProducts) {
    <div class="col-md-4 col-lg-2 mb-3"><div class="card h-100 product-card">
        <img class="card-img-top product-image" src="@Url.Content(string.IsNullOrWhiteSpace(p.ProductImage) ? "~/Content/no-image.svg" : p.ProductImage)" alt="@p.ProductName" />
        <div class="card-body p-3"><h6>@p.ProductName</h6><p class="price">@p.ProductPrice.ToString("N0") đ</p><a href="@Url.Action("ProductDetail",new{id=p.ProductID})">Chi tiết</a></div>
    </div></div>
}
</div>
