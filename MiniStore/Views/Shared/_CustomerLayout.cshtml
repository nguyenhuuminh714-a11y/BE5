<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - MiniStore</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/site.css")" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <a class="navbar-brand font-weight-bold" href="@Url.Action("Index","Home")">MiniStore</a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#nav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav mr-auto">
            <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Home")">Trang chủ</a></li>
            <li class="nav-item"><a class="nav-link" href="@Url.Action("ProductList","Home")">Sản phẩm</a></li>
            <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Cart")">Giỏ hàng (@(((System.Collections.Generic.List<MiniStore.Models.ViewModel.CartItem>)Session["Cart"] ?? new System.Collections.Generic.List<MiniStore.Models.ViewModel.CartItem>()).Sum(x => x.Quantity)))</a></li>
            @if (User.Identity.IsAuthenticated) {
                <li class="nav-item"><a class="nav-link" href="@Url.Action("MyOrder","Order")">Lịch sử mua hàng</a></li>
                <li class="nav-item"><a class="nav-link" href="@Url.Action("ProfileInfo","Account")">Tài khoản (@User.Identity.Name)</a></li>
                if (Session["UserRole"] != null && (string)Session["UserRole"] == "A") { <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Admin")">Quản trị</a></li> }
                <li class="nav-item"><a class="nav-link" href="@Url.Action("Logout","Account")">Đăng xuất</a></li>
            } else {
                <li class="nav-item"><a class="nav-link" href="@Url.Action("Login","Account")">Đăng nhập</a></li>
                <li class="nav-item"><a class="nav-link" href="@Url.Action("Register","Account")">Đăng ký</a></li>
            }
        </ul>
        @using (Html.BeginForm("ProductList","Home",FormMethod.Get,new {@class="form-inline"})) {
            <input class="form-control mr-2" name="searchTerm" placeholder="Tìm sản phẩm..." />
            <button class="btn btn-outline-light">Tìm</button>
        }
    </div>
</nav>
<main class="container py-4">
    @if (TempData["Message"] != null) { <div class="alert alert-info">@TempData["Message"]</div> }
    @RenderBody()
</main>
<footer class="bg-dark text-light text-center py-3 mt-4">MiniStore – Website bán hàng ASP.NET MVC 5 + Entity Framework</footer>
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("scripts", required: false)
</body></html>
